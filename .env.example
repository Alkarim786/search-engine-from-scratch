# Server
ADDR=:8080
INDEX_DIR=data/index
DATA_DIR=data
# Bearer token for POST /crawl (leave empty to disable the admin endpoint)
ADMIN_TOKEN=
# Optional file where successful queries are appended (feeds autocomplete)
QUERY_LOG=
# Minimum delay between requests to one host for admin crawls
CRAWL_DELAY=1s

# Crawler / indexer CLIs
CRAWL_SEEDS=https://docs.python.org/3/
CRAWL_PATH_PREFIX=/3/
CRAWL_OUT=data/pages.jsonl
